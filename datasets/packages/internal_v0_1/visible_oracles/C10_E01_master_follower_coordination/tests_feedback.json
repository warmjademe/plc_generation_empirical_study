{
  "schema_version": "1.0",
  "suite": "feedback",
  "task_id": "C10_E01_master_follower_coordination",
  "scan_period_ms": 100,
  "real_absolute_tolerance": 0.001,
  "cases": [
    {
      "id": "FT01",
      "name": "both_ready",
