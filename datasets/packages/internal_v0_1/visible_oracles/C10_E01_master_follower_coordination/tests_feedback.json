      "requirement_ids": [
        "R1",
        "R2"
      ],
      "fresh_instance": true,
      "steps": [
        {
          "inputs": {
            "RunRequest": true,
            "MasterReady": true,
            "FollowerReady": true
          },
          "expect": {
            "MasterRun": true,
            "FollowerRun": true
          },
          "repeat": 1,
          "check": "each"
        },
        {
          "inputs": {
            "RunRequest": false,
            "MasterReady": true,
            "FollowerReady": true
          },
          "expect": {
            "MasterRun": false,
            "FollowerRun": false
          },
          "repeat": 1,
          "check": "each"
        }
      ]
    }
  ]
