{
  "schema_version": "1.0",
  "dataset_version": "0.1.0",
  "id": "C02_M01_enabled_start_stop",
  "title": "Enabled start/stop with forced shutdown",
  "category_id": "C02",
  "category": "Start/stop and retained state",
  "difficulty": "medium",
  "iec_profile": "IEC-ST Core v1",
  "iec_features": [
    "FUNCTION_BLOCK",
    "BOOL",
    "retained output",
    "IF",
    "ELSIF",
    "priority"
  ],
  "complexity": {
    "retained_state": 1,
    "transitions": 3,
    "stateful_blocks": 1,
    "interactions": 2,
    "fault_modes": 1,
    "horizon_scans": 4,
    "inputs": 3,
    "outputs": 2,
    "requirements": 4
  },
  "interface": {
    "inputs": [
      {
        "name": "Enable",
        "type": "BOOL",
        "description": "Controller enable"
      },
      {
        "name": "Start",
        "type": "BOOL",
        "description": "Start command"
      },
      {
        "name": "Stop",
        "type": "BOOL",
        "description": "Stop command"
      }
    ],
    "outputs": [
      {
        "name": "Running",
        "type": "BOOL",
        "description": "Latched running state"
      },
      {
        "name": "Ready",
        "type": "BOOL",
        "description": "Controller can accept a start"
      }
    ]
  },
  "scan": {
    "period_ms": 100,
    "input_sampling": "scan_start",
    "output_observation": "scan_end",
    "initialization": "fresh function-block instance for every test case"
  },
  "assumptions": [
    "The function block is called exactly once per PLC scan.",
    "Inputs are sampled at scan start and outputs are checked at scan end.",
    "Each test starts from a fresh function-block instance."
  ],
  "requirements": [
    {
      "id": "R1",
      "text": "Ready shall be TRUE when Enable is TRUE and Stop is FALSE.",
      "safety_critical": false
    },
    {
      "id": "R2",
      "text": "Loss of Enable or assertion of Stop shall force Running FALSE.",
      "safety_critical": true
    },
    {
      "id": "R3",
      "text": "Start shall latch Running only while Ready is TRUE.",
      "safety_critical": false
    },
    {
      "id": "R4",
      "text": "Re-enabling without a new Start shall not restart the controller.",
      "safety_critical": true
    }
  ]
}
