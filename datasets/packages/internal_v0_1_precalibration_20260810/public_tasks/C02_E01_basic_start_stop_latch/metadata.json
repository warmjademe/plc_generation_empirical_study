{
  "schema_version": "1.0",
  "dataset_version": "0.1.0",
  "id": "C02_E01_basic_start_stop_latch",
  "title": "Stop-priority start/stop latch",
  "category_id": "C02",
  "category": "Start/stop and retained state",
  "difficulty": "easy",
  "iec_profile": "IEC-ST Core v1",
  "iec_features": [
    "FUNCTION_BLOCK",
    "BOOL",
    "retained output",
    "IF",
    "ELSIF"
  ],
  "complexity": {
    "retained_state": 1,
    "transitions": 2,
    "stateful_blocks": 0,
    "interactions": 0,
    "fault_modes": 0,
    "horizon_scans": 3,
    "inputs": 2,
    "outputs": 1,
    "requirements": 3
  },
  "interface": {
    "inputs": [
      {
        "name": "Start",
        "type": "BOOL",
        "description": "Start command"
      },
      {
        "name": "Stop",
        "type": "BOOL",
        "description": "Stop command"
      }
    ],
    "outputs": [
      {
        "name": "Running",
        "type": "BOOL",
        "description": "Latched running state"
      }
    ]
  },
  "scan": {
    "period_ms": 100,
    "input_sampling": "scan_start",
    "output_observation": "scan_end",
    "initialization": "fresh function-block instance for every test case"
  },
  "assumptions": [
    "The function block is called exactly once per PLC scan.",
    "Inputs are sampled at scan start and outputs are checked at scan end.",
    "Each test starts from a fresh function-block instance."
  ],
  "requirements": [
    {
      "id": "R1",
      "text": "A Start command shall latch Running TRUE when Stop is FALSE.",
      "safety_critical": false
    },
    {
      "id": "R2",
      "text": "Stop shall force Running FALSE and shall have priority when Start and Stop are simultaneous.",
      "safety_critical": true
    },
    {
      "id": "R3",
      "text": "Running shall retain its previous value when neither Start nor Stop is active.",
      "safety_critical": false
    }
  ]
}
