FUNCTION_BLOCK C06_W13_lean_composite
VAR_INPUT
    A_S1 : BOOL;
    A_S2 : BOOL;
    A_S3 : BOOL;
    B_Item : BOOL;
    B_Reset : BOOL;
    B_Target : INT;
    B_Enable : BOOL;
    SubsystemBEnable : BOOL;
    CrossReset : BOOL;
END_VAR
VAR_OUTPUT
    A_Vote : BOOL;
    A_Unanimous : BOOL;
    B_Count : INT;
    B_BatchDone : BOOL;
    B_Accepted : BOOL;
    CrossReady : BOOL;
    CrossBlocked : BOOL;
END_VAR
VAR
    B_PrevItem : BOOL := FALSE;
END_VAR

A_Vote := (A_S1 AND A_S2) OR (A_S1 AND A_S3) OR (A_S2 AND A_S3);
A_Unanimous := (A_S1 AND A_S2 AND A_S3) OR ((NOT A_S1) AND (NOT A_S2) AND (NOT A_S3));

IF CrossReset THEN
    CrossReady := FALSE;
ELSIF A_Vote THEN
    CrossReady := TRUE;
END_IF;
CrossBlocked := FALSE;

IF SubsystemBEnable AND CrossReady THEN
    B_Accepted := FALSE;
    IF B_Reset THEN
        B_Count := 0;
    ELSIF B_Enable AND B_Item AND (NOT B_PrevItem) AND (B_Count < B_Target) THEN
        B_Count := B_Count + 1;
        B_Accepted := TRUE;
    END_IF;
    B_BatchDone := B_Count >= B_Target;
    B_PrevItem := B_Item;
ELSE
    B_Count := 0;
    B_BatchDone := FALSE;
    B_Accepted := FALSE;
END_IF;

END_FUNCTION_BLOCK
