{
  "schema_version": "1.0",
  "dataset_version": "0.2.0-dev",
  "id": "C10_X01_three_pump_feedback_dispatch",
  "title": "Three-pump staged dispatch with lead preference and feedback exclusion",
  "category_id": "C10",
  "category": "Multi-device coordination",
  "difficulty": "hard",
  "iec_profile": "IEC-ST Core v1",
  "iec_features": [
    "FUNCTION_BLOCK",
    "BOOL",
    "INT",
    "TIME",
    "TON",
    "multi-device dispatch",
    "cyclic priority",
    "feedback exclusion"
  ],
  "complexity": {
    "retained_state": 5,
    "transitions": 14,
    "stateful_blocks": 3,
    "interactions": 12,
    "fault_modes": 5,
    "horizon_scans": 14,
    "inputs": 11,
    "outputs": 6,
    "requirements": 6
  },
  "interface": {
    "inputs": [
      {
        "name": "LowDemand",
        "type": "BOOL",
        "description": "One-pump demand"
      },
      {
        "name": "HighDemand",
        "type": "BOOL",
        "description": "Two-pump demand"
      },
      {
        "name": "Lead",
        "type": "INT",
        "description": "Preferred pump 1, 2, or 3"
      },
      {
        "name": "Available1",
        "type": "BOOL",
        "description": "Pump 1 availability"
      },
      {
        "name": "Available2",
        "type": "BOOL",
        "description": "Pump 2 availability"
      },
      {
        "name": "Available3",
        "type": "BOOL",
        "description": "Pump 3 availability"
      },
      {
        "name": "Feedback1",
        "type": "BOOL",
        "description": "Pump 1 running feedback"
      },
      {
        "name": "Feedback2",
        "type": "BOOL",
        "description": "Pump 2 running feedback"
      },
      {
        "name": "Feedback3",
        "type": "BOOL",
        "description": "Pump 3 running feedback"
      },
      {
        "name": "Stop",
        "type": "BOOL",
        "description": "Immediate stop"
      },
      {
        "name": "Reset",
        "type": "BOOL",
        "description": "Failure reset"
      }
    ],
    "outputs": [
      {
        "name": "Run1",
        "type": "BOOL",
        "description": "Pump 1 command"
      },
      {
        "name": "Run2",
        "type": "BOOL",
        "description": "Pump 2 command"
      },
      {
        "name": "Run3",
        "type": "BOOL",
        "description": "Pump 3 command"
      },
      {
        "name": "ActiveCount",
        "type": "INT",
        "description": "Number of commanded pumps"
      },
      {
        "name": "Failover",
        "type": "BOOL",
        "description": "Lead or requested capacity was replaced"
      },
      {
        "name": "Fault",
        "type": "BOOL",
        "description": "Latched insufficient-capacity fault"
      }
    ]
  },
  "scan": {
    "period_ms": 100,
    "input_sampling": "scan_start",
    "output_observation": "scan_end",
    "initialization": "fresh function-block instance for every test case"
  },
  "assumptions": [
    "The runtime scan period is 100 ms.",
    "At most two pumps are required simultaneously.",
    "Each test starts from a fresh function-block instance."
  ],
  "requirements": [
    {
      "id": "R1",
      "text": "LowDemand shall request one pump and HighDemand shall request two, with HighDemand taking priority.",
      "property": "G(required_count = mux(HighDemand,2,mux(LowDemand,1,0)))",
      "safety_critical": false
    },
    {
      "id": "R2",
      "text": "Dispatch shall prefer Lead, then the next pump numbers cyclically, excluding unavailable or feedback-failed pumps.",
      "property": "G(dispatched_order = cyclic_available_order(Lead))",
      "safety_critical": false
    },
    {
      "id": "R3",
      "text": "A commanded pump without feedback for 300 ms shall be excluded and replaced when capacity permits.",
      "property": "G(no_feedback_3 -> !corresponding_run)",
      "safety_critical": true
    },
    {
      "id": "R4",
      "text": "ActiveCount shall equal the number of TRUE run outputs, and no more than two pumps may run.",
      "property": "G(ActiveCount=count_true(Run1,Run2,Run3)) AND G(ActiveCount<=2)",
      "safety_critical": true
    },
    {
      "id": "R5",
      "text": "Failover shall be TRUE when an unhealthy preferred pump is bypassed or requested capacity cannot be met; insufficient capacity shall latch Fault.",
      "property": "G(ActiveCount<required_count -> (Failover AND Fault))",
      "safety_critical": true
    },
    {
      "id": "R6",
      "text": "Stop shall immediately clear every run command; Reset clears failures only while both demand inputs and Stop are FALSE.",
      "property": "G(Stop -> (!Run1 AND !Run2 AND !Run3)) AND G(qualified_reset -> !Fault)",
      "safety_critical": true
    }
  ],
  "provenance": {
    "origin": "newly authored for IEC-ST-VerifyBench",
    "public_before_evaluation": false,
    "license": "research-internal; public license pending"
  },
  "review": {
    "author_review": "pending",
    "independent_review": "pending"
  }
}
