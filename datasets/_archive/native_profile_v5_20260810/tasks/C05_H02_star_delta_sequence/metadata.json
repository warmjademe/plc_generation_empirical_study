{
  "schema_version": "1.0",
  "dataset_version": "0.2.0-dev",
  "id": "C05_H02_star_delta_sequence",
  "title": "Star-delta motor transition",
  "category_id": "C05",
  "category": "Timers and timeouts",
  "difficulty": "hard",
  "iec_profile": "IEC-ST Core v1",
  "iec_features": [
    "FUNCTION_BLOCK",
    "BOOL",
    "TIME",
    "TON",
    "retained outputs",
    "timed transition",
    "interlock"
  ],
  "complexity": {
    "retained_state": 5,
    "transitions": 7,
    "stateful_blocks": 2,
    "interactions": 6,
    "fault_modes": 2,
    "horizon_scans": 12,
    "inputs": 4,
    "outputs": 4,
    "requirements": 5
  },
  "interface": {
    "inputs": [
      {
        "name": "Start",
        "type": "BOOL",
        "description": "Start command"
      },
      {
        "name": "Stop",
        "type": "BOOL",
        "description": "Stop command"
      },
      {
        "name": "Overload",
        "type": "BOOL",
        "description": "Motor overload"
      },
      {
        "name": "Reset",
        "type": "BOOL",
        "description": "Fault reset"
      }
    ],
    "outputs": [
      {
        "name": "Main",
        "type": "BOOL",
        "description": "Main contactor"
      },
      {
        "name": "Star",
        "type": "BOOL",
        "description": "Star contactor"
      },
      {
        "name": "Delta",
        "type": "BOOL",
        "description": "Delta contactor"
      },
      {
        "name": "Fault",
        "type": "BOOL",
        "description": "Latched overload fault"
      }
    ]
  },
  "scan": {
    "period_ms": 100,
    "input_sampling": "scan_start",
    "output_observation": "scan_end",
    "initialization": "fresh function-block instance for every test case"
  },
  "assumptions": [
    "The runtime scan period is 100 ms.",
    "Start may remain TRUE during normal operation.",
    "Each test starts from a fresh function-block instance."
  ],
  "requirements": [
    {
      "id": "R1",
      "text": "Start shall energize Main and Star when no fault, Stop, or Overload is active.",
      "property": "G((Start AND !Stop AND !Overload AND !Fault AND phase=idle) -> (Main AND Star AND !Delta))",
      "safety_critical": false
    },
    {
      "id": "R2",
      "text": "After 500 ms in Star, Star shall turn off before Delta turns on after a 200 ms transition gap.",
      "property": "G(Delta -> (Main AND !Star AND elapsed_star>=7))",
      "safety_critical": true
    },
    {
      "id": "R3",
      "text": "Star and Delta shall never be TRUE together.",
      "property": "G(!(Star AND Delta))",
      "safety_critical": true
    },
    {
      "id": "R4",
      "text": "Stop or Overload shall immediately turn off all contactors; Overload latches Fault.",
      "property": "G((Stop OR Overload) -> (!Main AND !Star AND !Delta))",
      "safety_critical": true
    },
    {
      "id": "R5",
      "text": "Reset clears Fault only while Start is FALSE and Overload is FALSE.",
      "property": "G((Reset AND !Start AND !Overload) -> !Fault)",
      "safety_critical": false
    }
  ],
  "provenance": {
    "origin": "newly authored for IEC-ST-VerifyBench",
    "public_before_evaluation": false,
    "license": "research-internal; public license pending"
  },
  "review": {
