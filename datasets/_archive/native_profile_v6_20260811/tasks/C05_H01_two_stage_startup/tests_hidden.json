{
  "schema_version": "1.0",
  "suite": "hidden",
  "task_id": "C05_H01_two_stage_startup",
  "scan_period_ms": 100,
  "real_absolute_tolerance": 0.001,
  "cases": [
    {
      "id": "HT01",
      "name": "timeout_and_fault_reset",
      "description": "Latch a feedback timeout and require released Start for fault reset.",
      "requirement_ids": [
        "R3",
        "R4",
        "R5"
      ],
      "fresh_instance": true,
      "steps": [
        {
          "inputs": {
            "Start": true,
            "Stop": false,
            "Permit": true,
            "Stage1Feedback": false
          },
          "expect": {
            "Stage1": false,
            "Stage2": false,
            "Fault": true
          },
          "repeat": 8,
          "check": "last_only"
        },
        {
          "inputs": {
            "Start": true,
            "Stop": true,
            "Permit": true,
            "Stage1Feedback": false
          },
          "expect": {
            "Stage1": false,
            "Stage2": false,
            "Fault": true
          },
          "repeat": 1,
          "check": "each"
        },
        {
          "inputs": {
            "Start": false,
            "Stop": true,
            "Permit": true,
            "Stage1Feedback": false
          },
          "expect": {
            "Stage1": false,
            "Stage2": false,
            "Fault": false
          },
          "repeat": 1,
          "check": "each"
        }
      ]
    }
  ]
}
