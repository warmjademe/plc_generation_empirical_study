{
  "schema_version": "1.0",
  "dataset_version": "0.2.0-dev",
  "id": "C03_X01_ventilated_heater_interlock",
  "title": "Ventilated heater startup with proof timeout",
  "category_id": "C03",
  "category": "Interlocks and safe outputs",
  "difficulty": "hard",
  "iec_profile": "IEC-ST Core v1",
  "iec_features": [
    "FUNCTION_BLOCK",
    "BOOL",
    "INT",
    "TIME",
    "TON",
    "retained state",
    "proof timeout",
    "interlock"
  ],
  "complexity": {
    "retained_state": 3,
    "transitions": 9,
    "stateful_blocks": 2,
    "interactions": 8,
    "fault_modes": 3,
    "horizon_scans": 12,
    "inputs": 6,
    "outputs": 5,
    "requirements": 6
  },
  "interface": {
    "inputs": [
      {
        "name": "HeatRequest",
        "type": "BOOL",
        "description": "Heat demand"
      },
      {
        "name": "Stop",
        "type": "BOOL",
        "description": "Stop command"
      },
      {
        "name": "GuardClosed",
        "type": "BOOL",
        "description": "Guard safety input"
      },
      {
        "name": "DamperOpen",
        "type": "BOOL",
        "description": "Damper proof"
      },
      {
        "name": "AirflowOK",
        "type": "BOOL",
        "description": "Airflow proof"
      },
      {
        "name": "Reset",
        "type": "BOOL",
        "description": "Fault reset"
      }
    ],
    "outputs": [
      {
        "name": "DamperCommand",
        "type": "BOOL",
        "description": "Open-damper command"
      },
      {
        "name": "FanCommand",
        "type": "BOOL",
        "description": "Ventilation fan command"
      },
      {
        "name": "HeaterCommand",
        "type": "BOOL",
        "description": "Heater command"
      },
      {
        "name": "Fault",
        "type": "BOOL",
        "description": "Latched proof fault"
      },
      {
        "name": "State",
        "type": "INT",
        "description": "0 idle, 1 proving ventilation, 2 heating"
      }
    ]
  },
  "scan": {
    "period_ms": 100,
    "input_sampling": "scan_start",
    "output_observation": "scan_end",
    "initialization": "fresh function-block instance for every test case"
  },
  "assumptions": [
    "The runtime scan period is 100 ms.",
    "Proof inputs are sampled at scan start.",
    "Each test starts from a fresh function-block instance."
  ],
  "requirements": [
    {
      "id": "R1",
      "text": "A healthy HeatRequest shall enter ventilation proving and command the damper and fan before the heater.",
      "property": "G((State=0 AND HeatRequest AND GuardClosed AND !Stop AND !Fault)->X(State=1))",
      "safety_critical": false
    },
    {
      "id": "R2",
      "text": "HeaterCommand may energize only after DamperOpen and AirflowOK remain TRUE for 300 ms.",
      "property": "G(HeaterCommand -> continuous(DamperOpen AND AirflowOK,3))",
      "safety_critical": true
    },
    {
      "id": "R3",
      "text": "Failure to establish both proofs within 600 ms shall latch Fault and force all commands FALSE.",
      "property": "G(proof_timeout -> (Fault AND !DamperCommand AND !FanCommand AND !HeaterCommand))",
      "safety_critical": true
    },
    {
      "id": "R4",
      "text": "Loss of GuardClosed, DamperOpen, or AirflowOK while heating shall immediately trip and latch Fault.",
      "property": "G((State=2 AND (!GuardClosed OR !DamperOpen OR !AirflowOK)) -> Fault)",
      "safety_critical": true
    },
    {
      "id": "R5",
      "text": "Stop shall return to idle without clearing Fault; Reset clears Fault only while idle with HeatRequest FALSE.",
      "property": "G(Stop -> State=0) AND G((Reset AND State=0 AND !HeatRequest)->!Fault)",
      "safety_critical": false
    },
    {
      "id": "R6",
      "text": "HeaterCommand shall never be TRUE unless DamperCommand and FanCommand are both TRUE.",
      "property": "G(HeaterCommand -> (DamperCommand AND FanCommand))",
      "safety_critical": true
    }
  ],
  "provenance": {
    "origin": "newly authored for IEC-ST-VerifyBench",
