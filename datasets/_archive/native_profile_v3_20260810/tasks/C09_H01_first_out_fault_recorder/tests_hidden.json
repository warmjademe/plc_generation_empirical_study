{
  "schema_version": "1.0",
  "suite": "hidden",
  "task_id": "C09_H01_first_out_fault_recorder",
  "scan_period_ms": 100,
  "real_absolute_tolerance": 0.001,
  "cases": [
    {
      "id": "HT01",
      "name": "simultaneous_priority_and_reset",
      "description": "Resolve simultaneous faults and require all inputs clear for reset.",
      "requirement_ids": [
        "R1",
        "R2",
        "R3",
        "R5"
      ],
      "fresh_instance": true,
      "steps": [
        {
          "inputs": {
            "FaultA": true,
            "FaultB": true,
            "FaultC": true,
            "Reset": false
          },
          "expect": {
            "AnyFault": true,
            "LockedOut": true,
            "FirstFault": 1
          },
          "repeat": 1,
          "check": "each"
        },
        {
          "inputs": {
            "FaultA": true,
            "FaultB": false,
            "FaultC": false,
            "Reset": true
          },
          "expect": {
            "AnyFault": true,
            "LockedOut": true,
            "FirstFault": 1
          },
          "repeat": 1,
          "check": "each"
        },
        {
          "inputs": {
            "FaultA": false,
            "FaultB": false,
            "FaultC": false,
            "Reset": true
          },
          "expect": {
            "AnyFault": false,
            "LockedOut": false,
            "FirstFault": 0
          },
          "repeat": 1,
          "check": "each"
        }
      ]
    }
  ]
}
