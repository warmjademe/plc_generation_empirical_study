{
  "schema_version": "1.0",
  "dataset_version": "0.2.0-dev",
  "id": "C10_M01_alternating_pump_starts",
  "title": "Alternating two-pump starts",
  "category_id": "C10",
  "category": "Multi-device coordination",
  "difficulty": "medium",
  "iec_profile": "IEC-ST Core v1",
  "iec_features": [
    "FUNCTION_BLOCK",
    "BOOL",
    "INT",
    "edge memory",
    "alternation",
    "availability fallback"
  ],
  "complexity": {
    "retained_state": 4,
    "transitions": 6,
    "stateful_blocks": 1,
    "interactions": 5,
    "fault_modes": 2,
    "horizon_scans": 5,
    "inputs": 4,
    "outputs": 4,
    "requirements": 5
  },
  "interface": {
    "inputs": [
      {
        "name": "Demand",
        "type": "BOOL",
        "description": "Pump demand"
      },
      {
        "name": "Pump1Available",
        "type": "BOOL",
        "description": "Pump 1 availability"
      },
      {
        "name": "Pump2Available",
        "type": "BOOL",
        "description": "Pump 2 availability"
      },
      {
        "name": "Reset",
        "type": "BOOL",
        "description": "Alternation reset"
      }
    ],
    "outputs": [
      {
        "name": "Pump1Run",
        "type": "BOOL",
        "description": "Pump 1 command"
      },
      {
        "name": "Pump2Run",
        "type": "BOOL",
        "description": "Pump 2 command"
      },
      {
        "name": "NextPump",
        "type": "INT",
        "description": "Preferred pump for next demand: 1 or 2"
      },
      {
        "name": "Unavailable",
        "type": "BOOL",
        "description": "No available pump for demand"
      }
    ]
  },
  "scan": {
    "period_ms": 100,
    "input_sampling": "scan_start",
    "output_observation": "scan_end",
    "initialization": "fresh function-block instance for every test case"
  },
  "assumptions": [
    "The function block is called exactly once per PLC scan.",
    "Inputs are sampled at scan start and outputs are checked at scan end.",
    "Each test starts from a fresh function-block instance."
  ],
  "requirements": [
    {
      "id": "R1",
      "text": "Each rising Demand shall start at most one available pump.",
      "property": "G(!(Pump1Run AND Pump2Run))",
      "safety_critical": true
    },
    {
      "id": "R2",
      "text": "When both pumps are available, successive demand episodes shall alternate the selected pump.",
      "property": "G(alternating_rising_demands -> alternating_selected_pumps)",
      "safety_critical": false
    },
    {
      "id": "R3",
      "text": "If the preferred pump is unavailable, the other available pump shall run.",
      "property": "G((Demand AND exactly_one_available) -> (Pump1Run OR Pump2Run))",
      "safety_critical": false
    },
    {
      "id": "R4",
      "text": "Unavailable shall be TRUE exactly when Demand is TRUE and neither pump is available.",
      "property": "G(Unavailable = (Demand AND !Pump1Available AND !Pump2Available))",
      "safety_critical": false
    },
    {
      "id": "R5",
      "text": "Reset without Demand shall set NextPump to 1 and stop both pumps.",
      "property": "G((Reset AND !Demand) -> (NextPump=1 AND !Pump1Run AND !Pump2Run))",
      "safety_critical": false
    }
  ],
  "provenance": {
    "origin": "newly authored for IEC-ST-VerifyBench",
    "public_before_evaluation": false,
    "license": "research-internal; public license pending"
  },
  "review": {
    "author_review": "pending",
    "independent_review": "pending"
  }
}
