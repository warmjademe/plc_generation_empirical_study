{
  "schema_version": "1.0",
  "dataset_version": "0.2.0-dev",
  "id": "C09_X01_shelved_alarm_lifecycle",
  "title": "Delayed warning, immediate trip, shelving, acknowledgement, and reset",
  "category_id": "C09",
  "category": "Alarms and fault recovery",
  "difficulty": "hard",
  "iec_profile": "IEC-ST Core v1",
  "iec_features": [
    "FUNCTION_BLOCK",
    "BOOL",
    "TIME",
    "TON",
    "retained alarm",
    "shelving",
    "acknowledgement",
    "priority"
  ],
  "complexity": {
    "retained_state": 5,
    "transitions": 11,
    "stateful_blocks": 1,
    "interactions": 10,
    "fault_modes": 4,
    "horizon_scans": 12,
    "inputs": 6,
    "outputs": 5,
    "requirements": 6
  },
  "interface": {
    "inputs": [
      {
        "name": "WarningCondition",
        "type": "BOOL",
        "description": "Warning condition"
      },
      {
        "name": "TripCondition",
        "type": "BOOL",
        "description": "Trip condition"
      },
      {
        "name": "Enable",
        "type": "BOOL",
        "description": "Alarm enable"
      },
      {
        "name": "Shelve",
        "type": "BOOL",
        "description": "Warning shelving request"
      },
      {
        "name": "Acknowledge",
        "type": "BOOL",
        "description": "Operator acknowledgement"
      },
      {
        "name": "Reset",
        "type": "BOOL",
        "description": "Qualified trip reset"
      }
    ],
    "outputs": [
      {
        "name": "Warning",
        "type": "BOOL",
        "description": "Delayed warning indication"
      },
      {
        "name": "Trip",
        "type": "BOOL",
        "description": "Latched trip"
      },
      {
        "name": "Unacked",
        "type": "BOOL",
        "description": "Active alarm not acknowledged"
      },
      {
        "name": "Shelved",
        "type": "BOOL",
        "description": "Warning display is shelved"
      },
      {
        "name": "LockedOut",
        "type": "BOOL",
        "description": "Trip lockout"
      }
    ]
  },
  "scan": {
    "period_ms": 100,
    "input_sampling": "scan_start",
    "output_observation": "scan_end",
    "initialization": "fresh function-block instance for every test case"
  },
  "assumptions": [
    "The runtime scan period is 100 ms.",
    "Acknowledge may be held for more than one scan.",
    "Each test starts from a fresh function-block instance."
  ],
  "requirements": [
    {
      "id": "R1",
      "text": "An enabled WarningCondition shall become Warning after 300 ms unless shelved or a trip is active.",
      "property": "G(Warning -> continuous(Enable AND WarningCondition AND !Shelved AND !Trip,3))",
      "safety_critical": false
    },
    {
      "id": "R2",
      "text": "Shelve may suppress only warnings; TripCondition shall latch Trip and LockedOut immediately regardless of Shelve.",
      "property": "G((Enable AND TripCondition)->(Trip AND LockedOut))",
      "safety_critical": true
    },
    {
      "id": "R3",
      "text": "Every newly displayed Warning or Trip shall set Unacked; Acknowledge clears Unacked without clearing active alarms.",
      "property": "G(new_alarm -> Unacked)",
      "safety_critical": false
    },
    {
      "id": "R4",
      "text": "Shelved follows Shelve only while no trip is active; a trip cancels Shelved.",
      "property": "G(Trip -> !Shelved)",
      "safety_critical": true
    },
    {
      "id": "R5",
      "text": "Enable FALSE shall suppress Warning but shall not clear Trip or LockedOut.",
      "property": "G(!Enable -> !Warning)",
      "safety_critical": false
    },
    {
      "id": "R6",
      "text": "Reset clears Trip and LockedOut only when disabled and both conditions are FALSE.",
      "property": "G((Reset AND !Enable AND !WarningCondition AND !TripCondition)->(!Trip AND !LockedOut))",
      "safety_critical": true
    }
  ],
  "provenance": {
