{
  "schema_version": "1.0",
  "dataset_version": "0.2.0-dev",
  "id": "C07_X01_plausible_rate_limited_fusion",
  "title": "Redundant sensor fusion with plausibility and rate trip",
  "category_id": "C07",
  "category": "Analog processing",
  "difficulty": "hard",
  "iec_profile": "IEC-ST Core v1",
  "iec_features": [
    "FUNCTION_BLOCK",
    "BOOL",
    "REAL",
    "ABS",
    "retained state",
    "sensor fusion",
    "boundary",
    "latched trip"
  ],
  "complexity": {
    "retained_state": 3,
    "transitions": 8,
    "stateful_blocks": 0,
    "interactions": 10,
    "fault_modes": 4,
    "horizon_scans": 8,
    "inputs": 8,
    "outputs": 5,
    "requirements": 6
  },
  "interface": {
    "inputs": [
      {
        "name": "SensorA",
        "type": "REAL",
        "description": "Sensor A value"
      },
      {
        "name": "SensorB",
        "type": "REAL",
        "description": "Sensor B value"
      },
      {
        "name": "ValidA",
        "type": "BOOL",
        "description": "Sensor A validity"
      },
      {
        "name": "ValidB",
        "type": "BOOL",
        "description": "Sensor B validity"
      },
      {
        "name": "Enable",
        "type": "BOOL",
        "description": "Fusion enable"
      },
      {
        "name": "MaxDifference",
        "type": "REAL",
        "description": "Maximum pair disagreement"
      },
      {
        "name": "MaxRate",
        "type": "REAL",
        "description": "Maximum accepted per-scan change"
      },
      {
        "name": "Reset",
        "type": "BOOL",
        "description": "Rate-trip reset"
      }
    ],
    "outputs": [
      {
        "name": "ProcessValue",
        "type": "REAL",
        "description": "Accepted fused value"
      },
      {
        "name": "ValidOutput",
        "type": "BOOL",
        "description": "ProcessValue is usable"
      },
      {
        "name": "Degraded",
        "type": "BOOL",
        "description": "Only one sensor is used"
      },
      {
        "name": "Disagree",
        "type": "BOOL",
        "description": "Both valid sensors disagree"
      },
      {
        "name": "RateTrip",
        "type": "BOOL",
        "description": "Latched excessive rate change"
      }
    ]
  },
  "scan": {
    "period_ms": 100,
    "input_sampling": "scan_start",
    "output_observation": "scan_end",
    "initialization": "fresh function-block instance for every test case"
  },
  "assumptions": [
    "The function block is called exactly once per PLC scan.",
    "Inputs are sampled at scan start and outputs are checked at scan end.",
    "Each test starts from a fresh function-block instance."
  ],
  "requirements": [
    {
      "id": "R1",
      "text": "When both sensors are valid and their absolute difference is at most MaxDifference, the candidate value is their average.",
      "property": "G(both_plausible -> candidate=(SensorA+SensorB)/2)",
      "safety_critical": false
    },
    {
      "id": "R2",
      "text": "When exactly one sensor is valid, the candidate is that sensor and Degraded is TRUE.",
      "property": "G(exactly_one_valid -> Degraded)",
      "safety_critical": false
    },
    {
      "id": "R3",
      "text": "When both valid sensors differ by more than MaxDifference, Disagree is TRUE and ValidOutput is FALSE.",
      "property": "G(disagreement -> (Disagree AND !ValidOutput))",
      "safety_critical": true
    },
    {
      "id": "R4",
      "text": "After initialization, an otherwise valid candidate changing by more than MaxRate shall latch RateTrip and shall not replace ProcessValue.",
      "property": "G((Ready AND candidate_valid AND abs(candidate-prev(ProcessValue))>MaxRate)->(RateTrip AND ProcessValue=prev(ProcessValue)))",
      "safety_critical": true
    },
    {
      "id": "R5",
      "text": "RateTrip or Enable FALSE shall force ValidOutput FALSE; Reset clears RateTrip only while disabled.",
      "property": "G((RateTrip OR !Enable)->!ValidOutput) AND G((Reset AND !Enable)->!RateTrip)",
      "safety_critical": true
    },
    {
      "id": "R6",
      "text": "At equality boundaries for MaxDifference and MaxRate, the candidate remains acceptable.",
      "property": "G(abs_difference=MaxDifference -> !Disagree)",
      "safety_critical": false
    }
  ],
  "provenance": {
    "origin": "newly authored for IEC-ST-VerifyBench",
    "public_before_evaluation": false,
    "license": "research-internal; public license pending"
  },
  "review": {
    "author_review": "pending",
    "independent_review": "pending"
  }
}
