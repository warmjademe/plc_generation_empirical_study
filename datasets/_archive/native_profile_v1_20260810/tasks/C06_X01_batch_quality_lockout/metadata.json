{
  "schema_version": "1.0",
  "dataset_version": "0.2.0-dev",
  "id": "C06_X01_batch_quality_lockout",
  "title": "Edge-counted batch with consecutive-reject lockout",
  "category_id": "C06",
  "category": "Counters and batch logic",
  "difficulty": "hard",
  "iec_profile": "IEC-ST Core v1",
  "iec_features": [
    "FUNCTION_BLOCK",
    "BOOL",
    "INT",
    "edge memory",
    "saturating state",
    "lockout",
    "qualified reset"
  ],
  "complexity": {
    "retained_state": 6,
    "transitions": 10,
    "stateful_blocks": 0,
    "interactions": 9,
    "fault_modes": 3,
    "horizon_scans": 12,
    "inputs": 6,
    "outputs": 5,
    "requirements": 6
  },
  "interface": {
    "inputs": [
      {
        "name": "ItemPulse",
        "type": "BOOL",
        "description": "Item completion signal"
      },
      {
        "name": "Rejected",
        "type": "BOOL",
        "description": "Current item rejection flag"
      },
      {
        "name": "Stop",
        "type": "BOOL",
        "description": "Batch stop"
      },
      {
        "name": "Reset",
        "type": "BOOL",
        "description": "Qualified reset"
      },
      {
        "name": "Target",
        "type": "INT",
        "description": "Required accepted items"
      },
      {
        "name": "RejectLimit",
        "type": "INT",
        "description": "Consecutive rejects causing lockout"
      }
    ],
    "outputs": [
      {
        "name": "AcceptedCount",
        "type": "INT",
        "description": "Accepted item count"
      },
      {
        "name": "RejectCount",
        "type": "INT",
        "description": "Total reject count"
      },
      {
        "name": "ConsecutiveRejects",
        "type": "INT",
        "description": "Current consecutive reject count"
      },
      {
        "name": "Complete",
        "type": "BOOL",
        "description": "Accepted target reached"
      },
      {
        "name": "LockedOut",
        "type": "BOOL",
        "description": "Consecutive reject lockout"
      }
    ]
  },
  "scan": {
    "period_ms": 100,
    "input_sampling": "scan_start",
    "output_observation": "scan_end",
    "initialization": "fresh function-block instance for every test case"
  },
  "assumptions": [
    "The function block is called exactly once per PLC scan.",
    "Inputs are sampled at scan start and outputs are checked at scan end.",
    "Each test starts from a fresh function-block instance."
  ],
  "requirements": [
    {
      "id": "R1",
      "text": "Only a rising ItemPulse while not stopped, complete, or locked shall count one item.",
      "property": "G(count_change -> (rose(ItemPulse) AND !Stop AND !prev(Complete) AND !prev(LockedOut)))",
      "safety_critical": false
    },
    {
      "id": "R2",
      "text": "An accepted item increments AcceptedCount and clears ConsecutiveRejects; a rejected item increments both reject counters.",
      "property": "G(accepted_edge -> (AcceptedCount=prev(AcceptedCount)+1 AND ConsecutiveRejects=0)) AND G(rejected_edge -> (RejectCount=prev(RejectCount)+1 AND ConsecutiveRejects=prev(ConsecutiveRejects)+1))",
      "safety_critical": false
    },
    {
      "id": "R3",
      "text": "Complete shall latch when AcceptedCount reaches positive Target and no later item may change counts.",
      "property": "G(Complete -> X(Complete))",
      "safety_critical": false
    },
    {
      "id": "R4",
      "text": "RejectLimit less than or equal to zero, or reaching RejectLimit consecutive rejects, shall latch LockedOut.",
      "property": "G((RejectLimit<=0 OR ConsecutiveRejects>=RejectLimit)->LockedOut)",
      "safety_critical": true
    },
    {
      "id": "R5",
      "text": "Stop has priority over ItemPulse and prevents every count change.",
      "property": "G(Stop -> stable(AcceptedCount,RejectCount,ConsecutiveRejects))",
      "safety_critical": true
    },
    {
      "id": "R6",
      "text": "Reset clears all state only while Stop is TRUE and ItemPulse is FALSE.",
      "property": "G((Reset AND Stop AND !ItemPulse)->(AcceptedCount=0 AND RejectCount=0 AND ConsecutiveRejects=0 AND !Complete AND !LockedOut))",
      "safety_critical": false
    }
  ],
  "provenance": {
    "origin": "newly authored for IEC-ST-VerifyBench",
    "public_before_evaluation": false,
    "license": "research-internal; public license pending"
  },
  "review": {
    "author_review": "pending",
    "independent_review": "pending"
  }
}
