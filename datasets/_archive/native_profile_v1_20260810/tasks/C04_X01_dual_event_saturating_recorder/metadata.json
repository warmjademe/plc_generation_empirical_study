{
  "schema_version": "1.0",
  "dataset_version": "0.2.0-dev",
  "id": "C04_X01_dual_event_saturating_recorder",
  "title": "Qualified dual-edge recorder with saturation and re-arm",
  "category_id": "C04",
  "category": "Edge and event handling",
  "difficulty": "hard",
  "iec_profile": "IEC-ST Core v1",
  "iec_features": [
    "FUNCTION_BLOCK",
    "BOOL",
    "INT",
    "IF",
    "edge memory",
    "priority",
    "saturation",
    "qualified reset"
  ],
  "complexity": {
    "retained_state": 5,
    "transitions": 9,
    "stateful_blocks": 0,
    "interactions": 8,
    "fault_modes": 2,
    "horizon_scans": 9,
    "inputs": 6,
    "outputs": 5,
    "requirements": 6
  },
  "interface": {
    "inputs": [
      {
        "name": "EventA",
        "type": "BOOL",
        "description": "Event channel A"
      },
      {
        "name": "EventB",
        "type": "BOOL",
        "description": "Event channel B"
      },
      {
        "name": "Qualify",
        "type": "BOOL",
        "description": "Event qualification"
      },
      {
        "name": "Inhibit",
        "type": "BOOL",
        "description": "Event inhibit"
      },
      {
        "name": "Reset",
        "type": "BOOL",
        "description": "Qualified reset"
      },
      {
        "name": "MaxCount",
        "type": "INT",
        "description": "Saturation count"
      }
    ],
    "outputs": [
      {
        "name": "PulseA",
        "type": "BOOL",
        "description": "Accepted A pulse"
      },
      {
        "name": "PulseB",
        "type": "BOOL",
        "description": "Accepted B pulse"
      },
      {
        "name": "Count",
        "type": "INT",
        "description": "Accepted event count"
      },
      {
        "name": "Locked",
        "type": "BOOL",
        "description": "Saturation lockout"
      },
      {
        "name": "LastSource",
        "type": "INT",
        "description": "0 none, 1 A, 2 B"
      }
    ]
  },
  "scan": {
    "period_ms": 100,
    "input_sampling": "scan_start",
    "output_observation": "scan_end",
    "initialization": "fresh function-block instance for every test case"
  },
  "assumptions": [
    "The function block is called exactly once per PLC scan.",
    "Inputs are sampled at scan start and outputs are checked at scan end.",
    "Each test starts from a fresh function-block instance."
  ],
  "requirements": [
    {
      "id": "R1",
      "text": "Only a qualified, non-inhibited rising edge may be accepted.",
      "property": "G((PulseA OR PulseB) -> (Qualify AND !Inhibit AND !Locked))",
      "safety_critical": true
    },
    {
      "id": "R2",
      "text": "Simultaneous eligible edges shall accept A only.",
      "property": "G((rose(EventA) AND rose(EventB) AND eligible) -> (PulseA AND !PulseB))",
      "safety_critical": true
    },
    {
      "id": "R3",
      "text": "Each accepted event increments Count once and records LastSource.",
      "property": "G((PulseA OR PulseB) -> (Count=prev(Count)+1))",
      "safety_critical": false
    },
    {
      "id": "R4",
      "text": "Count shall saturate at MaxCount and latch Locked; MaxCount less than or equal to zero locks without counting.",
      "property": "G((Count>=MaxCount OR MaxCount<=0)->Locked)",
      "safety_critical": true
    },
    {
      "id": "R5",
      "text": "A held-high event shall not retrigger until observed low and then rising again.",
      "property": "G((EventA AND prev(EventA))->!PulseA) AND G((EventB AND prev(EventB))->!PulseB)",
      "safety_critical": false
    },
    {
      "id": "R6",
      "text": "Reset clears Count, Locked, and LastSource only while both events are low.",
      "property": "G((Reset AND !EventA AND !EventB)->(Count=0 AND !Locked AND LastSource=0))",
      "safety_critical": false
    }
  ],
  "provenance": {
    "origin": "newly authored for IEC-ST-VerifyBench",
    "public_before_evaluation": false,
    "license": "research-internal; public license pending"
  },
  "review": {
    "author_review": "pending",
    "independent_review": "pending"
  }
}
