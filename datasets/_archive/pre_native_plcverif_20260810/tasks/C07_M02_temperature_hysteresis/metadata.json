{
  "schema_version": "1.0",
  "dataset_version": "0.1.0",
  "id": "C07_M02_temperature_hysteresis",
  "title": "Temperature control with hysteresis",
  "category_id": "C07",
  "category": "Analog processing",
  "difficulty": "medium",
  "iec_profile": "IEC-ST Core v1",
  "iec_features": [
    "FUNCTION_BLOCK",
    "BOOL",
    "REAL",
    "retained output",
    "IF",
    "ELSIF",
    "hysteresis"
  ],
  "complexity": {
    "retained_state": 1,
    "transitions": 3,
    "stateful_blocks": 0,
    "interactions": 3,
    "fault_modes": 1,
    "horizon_scans": 3,
    "inputs": 4,
    "outputs": 2,
    "requirements": 5
  },
  "interface": {
    "inputs": [
      {
        "name": "Temperature",
        "type": "REAL",
        "description": "Measured temperature"
      },
      {
        "name": "LowThreshold",
        "type": "REAL",
        "description": "Heater-on threshold"
      },
      {
        "name": "HighThreshold",
        "type": "REAL",
        "description": "Heater-off threshold"
      },
      {
        "name": "Enable",
        "type": "BOOL",
        "description": "Controller enable"
      }
    ],
    "outputs": [
      {
        "name": "Heater",
        "type": "BOOL",
        "description": "Latched heater command"
      },
      {
        "name": "ConfigError",
        "type": "BOOL",
        "description": "Threshold configuration invalid"
      }
    ]
  },
  "scan": {
    "period_ms": 100,
    "input_sampling": "scan_start",
    "output_observation": "scan_end",
    "initialization": "fresh function-block instance for every test case"
  },
  "assumptions": [
    "The function block is called exactly once per PLC scan.",
    "Inputs are sampled at scan start and outputs are checked at scan end.",
    "Each test starts from a fresh function-block instance."
  ],
  "requirements": [
    {
      "id": "R1",
      "text": "ConfigError shall be TRUE when LowThreshold is not less than HighThreshold.",
      "property": "G(ConfigError = (LowThreshold>=HighThreshold))",
      "safety_critical": true
    },
    {
      "id": "R2",
      "text": "Disable or ConfigError shall turn Heater off.",
      "property": "G((!Enable OR ConfigError) -> !Heater)",
      "safety_critical": true
    },
    {
      "id": "R3",
      "text": "While enabled with valid thresholds, Temperature below or equal to LowThreshold shall turn Heater on.",
      "property": "G((Enable AND !ConfigError AND Temperature<=LowThreshold) -> Heater)",
      "safety_critical": false
    },
    {
      "id": "R4",
      "text": "Temperature above or equal to HighThreshold shall turn Heater off.",
      "property": "G((Enable AND !ConfigError AND Temperature>=HighThreshold) -> !Heater)",
      "safety_critical": false
    },
    {
      "id": "R5",
      "text": "Between thresholds, Heater shall retain its previous state.",
      "property": "G((Enable AND !ConfigError AND Temperature>LowThreshold AND Temperature<HighThreshold) -> Heater=prev(Heater))",
      "safety_critical": false
    }
  ],
  "provenance": {
    "origin": "newly authored for IEC-ST-VerifyBench",
    "public_before_evaluation": false,
    "license": "research-internal; public license pending"
  },
  "review": {
    "author_review": "pending",
    "independent_review": "pending"
  }
}
