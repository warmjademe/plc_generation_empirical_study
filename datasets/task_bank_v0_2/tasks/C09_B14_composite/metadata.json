{
  "schema_version": "1.0",
  "dataset_version": "bank-0.2.0-dev",
  "id": "C09_B14_composite",
  "title": "Composed supervisory control: Time-qualified sensor disagreement alarm -> Delayed warning with trip lockout and acknowledgement",
  "category_id": "C09",
  "category": "Alarms and fault recovery",
  "difficulty": "hard",
  "iec_profile": "IEC-ST Core v1",
  "iec_features": [
    "ABS",
    "BOOL",
    "FUNCTION_BLOCK",
    "REAL",
    "TIME",
    "TON",
    "alarm acknowledgement",
    "compositional control",
    "edge memory",
    "latched readiness",
    "retained alarm",
    "supervisory interlock",
    "trip lockout"
  ],
  "complexity": {
    "retained_state": 7,
    "transitions": 15,
    "stateful_blocks": 2,
    "interactions": 16,
    "fault_modes": 5,
    "horizon_scans": 11,
    "inputs": 12,
    "outputs": 8,
    "requirements": 14
  },
  "interface": {
    "inputs": [
      {
        "name": "A_SensorA",
        "type": "REAL",
        "description": "Subsystem A: First sensor value"
      },
      {
        "name": "A_SensorB",
        "type": "REAL",
        "description": "Subsystem A: Second sensor value"
      },
      {
        "name": "A_MaxDifference",
        "type": "REAL",
        "description": "Subsystem A: Allowed absolute difference"
      },
      {
        "name": "A_Enable",
        "type": "BOOL",
        "description": "Subsystem A: Monitoring enable"
      },
      {
        "name": "A_Reset",
        "type": "BOOL",
        "description": "Subsystem A: Alarm reset"
      },
      {
        "name": "B_WarningCondition",
        "type": "BOOL",
        "description": "Subsystem B: Warning-level condition"
      },
      {
        "name": "B_TripCondition",
        "type": "BOOL",
        "description": "Subsystem B: Immediate trip condition"
      },
      {
        "name": "B_Enable",
        "type": "BOOL",
        "description": "Subsystem B: Alarm system enable"
      },
      {
        "name": "B_Acknowledge",
        "type": "BOOL",
        "description": "Subsystem B: Operator acknowledgement"
      },
      {
        "name": "B_Reset",
        "type": "BOOL",
        "description": "Subsystem B: Qualified trip reset"
      },
      {
        "name": "SubsystemBEnable",
        "type": "BOOL",
        "description": "Request execution of subsystem B"
      },
      {
        "name": "CrossReset",
        "type": "BOOL",
        "description": "High-priority supervisory readiness reset"
      }
    ],
    "outputs": [
      {
        "name": "A_Alarm",
        "type": "BOOL",
        "description": "Subsystem A: Latched disagreement alarm"
      },
      {
        "name": "A_Disagreeing",
        "type": "BOOL",
        "description": "Subsystem A: Current disagreement status"
      },
      {
        "name": "B_Warning",
        "type": "BOOL",
        "description": "Subsystem B: Time-qualified warning"
      },
      {
        "name": "B_Trip",
        "type": "BOOL",
        "description": "Subsystem B: Latched trip"
      },
      {
        "name": "B_Unacked",
        "type": "BOOL",
        "description": "Subsystem B: Unacknowledged active event"
      },
      {
        "name": "B_LockedOut",
        "type": "BOOL",
        "description": "Subsystem B: Equipment lockout"
      },
      {
        "name": "CrossReady",
        "type": "BOOL",
        "description": "Latched observation of A_Alarm"
      },
      {
        "name": "CrossBlocked",
        "type": "BOOL",
        "description": "SubsystemBEnable is requested without CrossReady"
      }
    ]
  },
  "scan": {
    "period_ms": 100,
    "input_sampling": "scan_start",
    "output_observation": "scan_end",
    "initialization": "fresh function-block instance for every test case"
  },
  "assumptions": [
    "The runtime scan period is 100 ms.",
    "MaxDifference is non-negative.",
    "Each test starts from a fresh function-block instance.",
    "Acknowledge has priority over a new Unacked indication within the same scan.",
    "Subsystem A executes before the supervisory latch and subsystem B within each scan.",
    "Requirements inherited from subsystem B apply only while SubsystemBEnable and CrossReady are TRUE.",
    "When subsystem B is isolated, its externally visible outputs take their type-safe defaults."
  ],
  "requirements": [
    {
      "id": "R1",
      "text": "Subsystem A shall satisfy: A_Disagreeing shall be TRUE exactly when monitoring is enabled and the absolute difference exceeds A_MaxDifference.",
      "property": "G(A_Disagreeing = (A_Enable AND ABS(A_SensorA-A_SensorB)>A_MaxDifference))",
      "safety_critical": false
    },
    {
      "id": "R2",
      "text": "Subsystem A shall satisfy: A disagreement lasting 300 ms shall latch A_Alarm.",
      "property": "G(within(3, A_Disagreeing, A_Alarm))",
      "safety_critical": false
    },
    {
      "id": "R3",
      "text": "Subsystem A shall satisfy: A shorter disagreement shall not latch A_Alarm.",
      "property": "G((A_Disagreeing AND duration(A_Disagreeing)<3) -> !A_Alarm)",
      "safety_critical": false
    },
    {
      "id": "R4",
      "text": "Subsystem A shall satisfy: A_Reset shall clear A_Alarm only while no disagreement is present.",
      "property": "G((A_Reset AND !A_Disagreeing) -> !A_Alarm)",
      "safety_critical": false
    },
    {
      "id": "R5",
      "text": "While SubsystemBEnable and CrossReady are TRUE, subsystem B shall satisfy: B_WarningCondition shall assert B_Warning only after it remains enabled for 300 ms.",
      "property": "G(within(3, (B_Enable AND B_WarningCondition), B_Warning))",
      "safety_critical": false
    },
    {
      "id": "R6",
      "text": "While SubsystemBEnable and CrossReady are TRUE, subsystem B shall satisfy: B_TripCondition while enabled shall immediately latch B_Trip and B_LockedOut.",
      "property": "G((B_Enable AND B_TripCondition) -> (B_Trip AND B_LockedOut))",
      "safety_critical": true
    },
    {
      "id": "R7",
      "text": "While SubsystemBEnable and CrossReady are TRUE, subsystem B shall satisfy: A newly asserted B_Warning or B_Trip shall set B_Unacked.",
      "property": "G((rose(B_Warning) OR rose(B_Trip)) -> B_Unacked)",
      "safety_critical": false
    },
    {
      "id": "R8",
      "text": "While SubsystemBEnable and CrossReady are TRUE, subsystem B shall satisfy: B_Acknowledge shall clear B_Unacked without clearing active B_Warning or latched B_Trip.",
      "property": "G(B_Acknowledge -> !B_Unacked)",
      "safety_critical": false
    },
    {
      "id": "R9",
      "text": "While SubsystemBEnable and CrossReady are TRUE, subsystem B shall satisfy: B_Reset shall clear B_Trip and B_LockedOut only while both conditions and B_Enable are FALSE.",
      "property": "G((B_Reset AND !B_Enable AND !B_WarningCondition AND !B_TripCondition) -> (!B_Trip AND !B_LockedOut))",
      "safety_critical": false
    },
    {
      "id": "R10",
      "text": "While SubsystemBEnable and CrossReady are TRUE, subsystem B shall satisfy: Disabling the system shall clear the non-latched B_Warning but not an existing B_Trip.",
      "property": "G(!B_Enable -> !B_Warning)",
      "safety_critical": true
    },
    {
      "id": "R11",
      "text": "A TRUE A_Alarm shall latch CrossReady unless CrossReset is TRUE in the same scan.",
      "property": "G(CrossReset -> !CrossReady) AND G((A_Alarm AND !CrossReset)->CrossReady)",
      "safety_critical": true
    },
    {
      "id": "R12",
      "text": "CrossReset shall have priority, clear CrossReady, and isolate every subsystem-B output to its type-safe default.",
      "property": "G(CrossReset -> (!CrossReady AND b_outputs_safe))",
      "safety_critical": true
    },
    {
      "id": "R13",
      "text": "Once set, CrossReady shall remain TRUE after the subsystem-A signal falls, until a later CrossReset scan.",
      "property": "G((CrossReady AND !CrossReset)->X(CrossReady))",
      "safety_critical": false
    },
    {
      "id": "R14",
      "text": "Subsystem B may execute only while SubsystemBEnable and CrossReady are TRUE; CrossBlocked is TRUE exactly when SubsystemBEnable is requested without CrossReady.",
      "property": "G(CrossBlocked = (SubsystemBEnable AND !CrossReady))",
      "safety_critical": true
    }
  ],
  "composition": {
    "base_a": "C09_M02_qualified_sensor_disagreement",
    "base_b": "C09_H02_delayed_warning_trip_lockout",
    "direction": "A_to_B",
    "activation_output": "A_Alarm"
  },
