{
  "schema_version": "1.0",
  "semantics": "end-of-scan state sequence; initial state precedes scan 1",
  "notation": "IEC-ST-VerifyBench temporal DSL; see SCHEMA.md",
  "properties": [
    {
      "id": "P1",
      "requirement_ids": [
        "R1"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G(A_ConfigError = (A_LowThreshold>=A_HighThreshold))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P2",
      "requirement_ids": [
        "R2"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G((!A_Enable OR A_ConfigError) -> !A_Heater)",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P3",
      "requirement_ids": [
        "R3"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G((A_Enable AND !A_ConfigError AND A_Temperature<=A_LowThreshold) -> A_Heater)",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P4",
      "requirement_ids": [
        "R4"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G((A_Enable AND !A_ConfigError AND A_Temperature>=A_HighThreshold) -> !A_Heater)",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P5",
      "requirement_ids": [
        "R5"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G((A_Enable AND !A_ConfigError AND A_Temperature>A_LowThreshold AND A_Temperature<A_HighThreshold) -> A_Heater=prev(A_Heater))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P6",
      "requirement_ids": [
        "R6"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G((B_ValidA AND B_ValidB AND ABS(B_SensorA-B_SensorB)<=B_MaxDifference) -> B_Selected=(B_SensorA+B_SensorB)/2.0)",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P7",
      "requirement_ids": [
        "R7"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G((B_ValidA AND B_ValidB AND ABS(B_SensorA-B_SensorB)>B_MaxDifference) -> (B_Disagree AND B_Selected=prev(B_Selected)))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P8",
      "requirement_ids": [
        "R8"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G((B_ValidA XOR B_ValidB) -> B_Degraded)",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P9",
      "requirement_ids": [
        "R9"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G((!B_ValidA AND !B_ValidB) -> (B_NoValidSensor AND B_Selected=prev(B_Selected)))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P10",
      "requirement_ids": [
        "R10"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G(at_most_one(B_Degraded,B_Disagree,B_NoValidSensor))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P11",
      "requirement_ids": [
        "R11"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G(CrossReset -> !CrossReady) AND G((A_Heater AND !CrossReset)->CrossReady)",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P12",
      "requirement_ids": [
        "R12"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G(CrossReset -> (!CrossReady AND b_outputs_safe))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P13",
      "requirement_ids": [
        "R13"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G((CrossReady AND !CrossReset)->X(CrossReady))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P14",
      "requirement_ids": [
        "R14"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G(CrossBlocked = (SubsystemBEnable AND !CrossReady))",
      "source": "independently authored from the requirement contract"
    }
  ]
}
