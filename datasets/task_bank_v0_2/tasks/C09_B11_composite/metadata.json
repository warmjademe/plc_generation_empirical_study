{
  "schema_version": "1.0",
  "dataset_version": "bank-0.2.0-dev",
  "id": "C09_B11_composite",
  "title": "Composed supervisory control: High and high-high alarm priority -> Time-qualified sensor disagreement alarm",
  "category_id": "C09",
  "category": "Alarms and fault recovery",
  "difficulty": "hard",
  "iec_profile": "IEC-ST Core v1",
  "iec_features": [
    "ABS",
    "BOOL",
    "FUNCTION_BLOCK",
    "REAL",
    "TIME",
    "TON",
    "comparisons",
    "compositional control",
    "latched readiness",
    "priority",
    "retained alarm",
    "retained alarms",
    "supervisory interlock"
  ],
  "complexity": {
    "retained_state": 5,
    "transitions": 11,
    "stateful_blocks": 1,
    "interactions": 13,
    "fault_modes": 5,
    "horizon_scans": 10,
    "inputs": 11,
    "outputs": 7,
    "requirements": 12
  },
  "interface": {
    "inputs": [
      {
        "name": "A_Value",
        "type": "REAL",
        "description": "Subsystem A: Measured process value"
      },
      {
        "name": "A_HighLimit",
        "type": "REAL",
        "description": "Subsystem A: High threshold"
      },
      {
        "name": "A_HighHighLimit",
        "type": "REAL",
        "description": "Subsystem A: High-high threshold"
      },
      {
        "name": "A_Reset",
        "type": "BOOL",
        "description": "Subsystem A: Latched alarm reset"
      },
      {
        "name": "B_SensorA",
        "type": "REAL",
        "description": "Subsystem B: First sensor value"
      },
      {
        "name": "B_SensorB",
        "type": "REAL",
        "description": "Subsystem B: Second sensor value"
      },
      {
        "name": "B_MaxDifference",
        "type": "REAL",
        "description": "Subsystem B: Allowed absolute difference"
      },
      {
        "name": "B_Enable",
        "type": "BOOL",
        "description": "Subsystem B: Monitoring enable"
      },
      {
        "name": "B_Reset",
        "type": "BOOL",
        "description": "Subsystem B: Alarm reset"
      },
      {
        "name": "SubsystemBEnable",
        "type": "BOOL",
        "description": "Request execution of subsystem B"
      },
      {
        "name": "CrossReset",
        "type": "BOOL",
        "description": "High-priority supervisory readiness reset"
      }
    ],
    "outputs": [
      {
        "name": "A_HighAlarm",
        "type": "BOOL",
        "description": "Subsystem A: Latched high alarm"
      },
      {
        "name": "A_HighHighAlarm",
        "type": "BOOL",
        "description": "Subsystem A: Latched high-high alarm"
      },
      {
        "name": "A_Shutdown",
        "type": "BOOL",
        "description": "Subsystem A: Latched shutdown command"
      },
      {
        "name": "B_Alarm",
        "type": "BOOL",
        "description": "Subsystem B: Latched disagreement alarm"
      },
      {
        "name": "B_Disagreeing",
        "type": "BOOL",
        "description": "Subsystem B: Current disagreement status"
      },
      {
        "name": "CrossReady",
        "type": "BOOL",
        "description": "Latched observation of A_HighAlarm"
      },
      {
        "name": "CrossBlocked",
        "type": "BOOL",
        "description": "SubsystemBEnable is requested without CrossReady"
      }
    ]
  },
  "scan": {
    "period_ms": 100,
    "input_sampling": "scan_start",
    "output_observation": "scan_end",
    "initialization": "fresh function-block instance for every test case"
  },
  "assumptions": [
    "HighHighLimit is greater than HighLimit.",
    "Each test starts from a fresh function-block instance.",
    "The runtime scan period is 100 ms.",
    "MaxDifference is non-negative.",
    "Subsystem A executes before the supervisory latch and subsystem B within each scan.",
    "Requirements inherited from subsystem B apply only while SubsystemBEnable and CrossReady are TRUE.",
    "When subsystem B is isolated, its externally visible outputs take their type-safe defaults."
  ],
  "requirements": [
    {
      "id": "R1",
      "text": "Subsystem A shall satisfy: A_Value at or above A_HighLimit shall latch A_HighAlarm.",
      "property": "G((A_Value>=A_HighLimit) -> A_HighAlarm)",
      "safety_critical": false
    },
    {
      "id": "R2",
      "text": "Subsystem A shall satisfy: A_Value at or above A_HighHighLimit shall latch both alarms and A_Shutdown.",
      "property": "G((A_Value>=A_HighHighLimit) -> (A_HighAlarm AND A_HighHighAlarm AND A_Shutdown))",
      "safety_critical": true
    },
    {
      "id": "R3",
      "text": "Subsystem A shall satisfy: A high alarm below A_HighHighLimit shall not by itself assert A_Shutdown.",
      "property": "G((A_Value>=A_HighLimit AND A_Value<A_HighHighLimit AND !A_HighHighAlarm) -> !A_Shutdown)",
      "safety_critical": false
    },
    {
      "id": "R4",
      "text": "Subsystem A shall satisfy: A_Reset shall clear all latched outputs only below A_HighLimit.",
      "property": "G((A_Reset AND A_Value<A_HighLimit) -> (!A_HighAlarm AND !A_HighHighAlarm AND !A_Shutdown))",
      "safety_critical": false
    },
    {
      "id": "R5",
      "text": "While SubsystemBEnable and CrossReady are TRUE, subsystem B shall satisfy: B_Disagreeing shall be TRUE exactly when monitoring is enabled and the absolute difference exceeds B_MaxDifference.",
      "property": "G(B_Disagreeing = (B_Enable AND ABS(B_SensorA-B_SensorB)>B_MaxDifference))",
      "safety_critical": false
    },
    {
      "id": "R6",
      "text": "While SubsystemBEnable and CrossReady are TRUE, subsystem B shall satisfy: A disagreement lasting 300 ms shall latch B_Alarm.",
      "property": "G(within(3, B_Disagreeing, B_Alarm))",
      "safety_critical": false
    },
    {
      "id": "R7",
      "text": "While SubsystemBEnable and CrossReady are TRUE, subsystem B shall satisfy: A shorter disagreement shall not latch B_Alarm.",
      "property": "G((B_Disagreeing AND duration(B_Disagreeing)<3) -> !B_Alarm)",
      "safety_critical": false
    },
    {
      "id": "R8",
      "text": "While SubsystemBEnable and CrossReady are TRUE, subsystem B shall satisfy: B_Reset shall clear B_Alarm only while no disagreement is present.",
      "property": "G((B_Reset AND !B_Disagreeing) -> !B_Alarm)",
      "safety_critical": false
    },
    {
      "id": "R9",
      "text": "A TRUE A_HighAlarm shall latch CrossReady unless CrossReset is TRUE in the same scan.",
      "property": "G(CrossReset -> !CrossReady) AND G((A_HighAlarm AND !CrossReset)->CrossReady)",
      "safety_critical": true
    },
    {
      "id": "R10",
      "text": "CrossReset shall have priority, clear CrossReady, and isolate every subsystem-B output to its type-safe default.",
      "property": "G(CrossReset -> (!CrossReady AND b_outputs_safe))",
      "safety_critical": true
    },
    {
      "id": "R11",
      "text": "Once set, CrossReady shall remain TRUE after the subsystem-A signal falls, until a later CrossReset scan.",
      "property": "G((CrossReady AND !CrossReset)->X(CrossReady))",
      "safety_critical": false
    },
    {
      "id": "R12",
      "text": "Subsystem B may execute only while SubsystemBEnable and CrossReady are TRUE; CrossBlocked is TRUE exactly when SubsystemBEnable is requested without CrossReady.",
      "property": "G(CrossBlocked = (SubsystemBEnable AND !CrossReady))",
      "safety_critical": true
    }
  ],
  "composition": {
    "base_a": "C09_M01_high_high_alarm_priority",
    "base_b": "C09_M02_qualified_sensor_disagreement",
    "direction": "A_to_B",
    "activation_output": "A_HighAlarm"
  },
  "provenance": {
    "origin": "deterministic ordered composition of independently specified base behaviors",
    "public_before_evaluation": false,
    "license": "research-internal; public license pending"
  },
  "review": {
    "author_review": "pending",
    "independent_review": "pending"
  }
}
