  "interface": {
    "inputs": [
      {
        "name": "A_WarningCondition",
        "type": "BOOL",
        "description": "Subsystem A: Warning-level condition"
      },
      {
        "name": "A_TripCondition",
        "type": "BOOL",
        "description": "Subsystem A: Immediate trip condition"
      },
      {
        "name": "A_Enable",
        "type": "BOOL",
        "description": "Subsystem A: Alarm system enable"
      },
      {
        "name": "A_Acknowledge",
        "type": "BOOL",
        "description": "Subsystem A: Operator acknowledgement"
      },
      {
        "name": "A_Reset",
        "type": "BOOL",
        "description": "Subsystem A: Qualified trip reset"
      },
      {
        "name": "B_Value",
        "type": "REAL",
        "description": "Subsystem B: Measured process value"
      },
      {
        "name": "B_HighLimit",
        "type": "REAL",
        "description": "Subsystem B: High threshold"
      },
      {
        "name": "B_HighHighLimit",
        "type": "REAL",
        "description": "Subsystem B: High-high threshold"
      },
      {
