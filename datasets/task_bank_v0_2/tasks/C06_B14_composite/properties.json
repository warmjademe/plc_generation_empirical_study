{
  "schema_version": "1.0",
  "semantics": "end-of-scan state sequence; initial state precedes scan 1",
  "notation": "IEC-ST-VerifyBench temporal DSL; see SCHEMA.md",
  "properties": [
    {
      "id": "P1",
      "requirement_ids": [
        "R1"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G((rose(A_AddItem) AND !rose(A_RemoveItem) AND prev(A_Count)<A_Capacity AND !A_Reset) -> A_Count=prev(A_Count)+1)",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P2",
      "requirement_ids": [
        "R2"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G((rose(A_RemoveItem) AND !rose(A_AddItem) AND prev(A_Count)>0 AND !A_Reset) -> A_Count=prev(A_Count)-1)",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P3",
      "requirement_ids": [
        "R3"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G((rose(A_AddItem) AND rose(A_RemoveItem) AND !A_Reset) -> ((A_Count=prev(A_Count)) AND A_Conflict))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P4",
      "requirement_ids": [
        "R4"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G((A_Count>=0) AND (A_Count<=A_Capacity) AND (A_Empty=(A_Count=0)) AND (A_Full=(A_Count>=A_Capacity)))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P5",
      "requirement_ids": [
        "R5"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G(A_Reset -> ((A_Count=0) AND !A_Conflict))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P6",
      "requirement_ids": [
        "R6"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G(rose(B_Inspected) AND !B_Reset AND !B_LockedOut -> update_window_counts)",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P7",
      "requirement_ids": [
        "R7"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G(B_WindowComplete -> ((B_WindowCount=0) AND (B_RejectCount=0)))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P8",
      "requirement_ids": [
        "R8"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G(completed_rejects>B_RejectLimit -> B_LockedOut)",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P9",
      "requirement_ids": [
        "R9"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G(B_LockedOut AND !B_Reset -> (B_WindowCount=prev(B_WindowCount) AND B_RejectCount=prev(B_RejectCount)))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P10",
      "requirement_ids": [
        "R10"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G(B_Reset -> (B_WindowCount=0 AND B_RejectCount=0 AND !B_WindowComplete AND !B_LockedOut))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P11",
      "requirement_ids": [
        "R11"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G(CrossReset -> !CrossReady) AND G((A_Empty AND !CrossReset)->CrossReady)",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P12",
      "requirement_ids": [
        "R12"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G(CrossReset -> (!CrossReady AND b_outputs_safe))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P13",
      "requirement_ids": [
        "R13"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G((CrossReady AND !CrossReset)->X(CrossReady))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P14",
      "requirement_ids": [
        "R14"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G(CrossBlocked = (SubsystemBEnable AND !CrossReady))",
