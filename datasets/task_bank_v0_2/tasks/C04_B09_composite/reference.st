FUNCTION_BLOCK C04_B09_composite
VAR_INPUT
    A_Signal : BOOL;
    A_Arm : BOOL;
    B_Event : BOOL;
    B_Qualify : BOOL;
    B_Reset : BOOL;
    B_MaxCount : INT;
    SubsystemBEnable : BOOL;
    CrossReset : BOOL;
END_VAR
VAR_OUTPUT
    A_Pulse : BOOL;
    A_Armed : BOOL;
    B_Count : INT;
    B_AcceptedPulse : BOOL;
    B_AtLimit : BOOL;
    CrossReady : BOOL;
    CrossBlocked : BOOL;
END_VAR
VAR
    A_PrevSignal : BOOL := FALSE;
    B_PrevEvent : BOOL := FALSE;
END_VAR

A_Pulse := A_Arm AND (NOT A_Signal) AND A_PrevSignal;
A_Armed := A_Arm;
A_PrevSignal := A_Signal;

IF CrossReset THEN
    CrossReady := FALSE;
ELSIF A_Pulse THEN
    CrossReady := TRUE;
END_IF;
CrossBlocked := SubsystemBEnable AND (NOT CrossReady);

IF SubsystemBEnable AND CrossReady THEN
    B_AcceptedPulse := FALSE;
    IF B_Reset THEN
        B_Count := 0;
    ELSIF B_Event AND (NOT B_PrevEvent) AND B_Qualify AND (B_Count < B_MaxCount) THEN
        B_Count := B_Count + 1;
        B_AcceptedPulse := TRUE;
    END_IF;
    B_AtLimit := B_Count >= B_MaxCount;
    B_PrevEvent := B_Event;
ELSE
    B_Count := 0;
    B_AcceptedPulse := FALSE;
    B_AtLimit := FALSE;
END_IF;

END_FUNCTION_BLOCK
