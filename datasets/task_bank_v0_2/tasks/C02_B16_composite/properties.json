      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P9",
      "requirement_ids": [
        "R9"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G((B_RestartRequired AND selected_start) -> (!B_Running AND B_RejectedStart))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P10",
      "requirement_ids": [
        "R10"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G((selected_start AND B_Enable AND B_SafetyOK AND !B_Stop AND !B_RestartRequired) -> B_Running)",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P11",
      "requirement_ids": [
        "R11"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G(CrossReset -> !CrossReady) AND G((A_Running AND !CrossReset)->CrossReady)",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P12",
      "requirement_ids": [
        "R12"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G(CrossReset -> (!CrossReady AND b_outputs_safe))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P13",
      "requirement_ids": [
        "R13"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G((CrossReady AND !CrossReset)->X(CrossReady))",
      "source": "independently authored from the requirement contract"
