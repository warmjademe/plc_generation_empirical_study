    {
      "id": "P2",
      "requirement_ids": [
        "R2"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G((A_Stop OR !A_Permit) -> !A_Running)",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P3",
      "requirement_ids": [
        "R3"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G((A_SelectedStart AND A_Permit AND !A_Stop) -> A_Running)",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P4",
      "requirement_ids": [
        "R4"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G((A_RemoteMode AND A_LocalStart AND !A_RemoteStart) -> !rose(A_Running))",
      "source": "independently authored from the requirement contract"
    },
