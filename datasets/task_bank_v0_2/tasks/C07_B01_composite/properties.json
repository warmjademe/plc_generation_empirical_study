{
  "schema_version": "1.0",
  "semantics": "end-of-scan state sequence; initial state precedes scan 1",
  "notation": "IEC-ST-VerifyBench temporal DSL; see SCHEMA.md",
  "properties": [
    {
      "id": "P1",
      "requirement_ids": [
        "R1"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G((A_ValidA AND A_ValidB AND ABS(A_SensorA-A_SensorB)<=A_MaxDifference) -> A_Selected=(A_SensorA+A_SensorB)/2.0)",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P2",
      "requirement_ids": [
        "R2"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G((A_ValidA AND A_ValidB AND ABS(A_SensorA-A_SensorB)>A_MaxDifference) -> (A_Disagree AND A_Selected=prev(A_Selected)))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P3",
      "requirement_ids": [
        "R3"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G((A_ValidA XOR A_ValidB) -> A_Degraded)",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P4",
      "requirement_ids": [
        "R4"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G((!A_ValidA AND !A_ValidB) -> (A_NoValidSensor AND A_Selected=prev(A_Selected)))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P5",
      "requirement_ids": [
        "R5"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G(at_most_one(A_Degraded,A_Disagree,A_NoValidSensor))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P6",
      "requirement_ids": [
        "R6"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G(rose(B_Enable) -> (B_Ready AND !B_Trip))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P7",
      "requirement_ids": [
        "R7"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G((B_Enable AND prev(B_Ready)) -> B_Delta=B_Value-prev(B_Value))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P8",
      "requirement_ids": [
        "R8"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G((B_Ready AND (B_Delta>B_MaxRise OR B_Delta<(-B_MaxFall))) -> B_Trip)",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P9",
      "requirement_ids": [
        "R9"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G((B_Trip AND !(B_Reset AND !B_Enable)) -> X(B_Trip))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P10",
      "requirement_ids": [
        "R10"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G(!B_Enable -> !B_Ready)",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P11",
      "requirement_ids": [
        "R11"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G(CrossReset -> !CrossReady) AND G((A_Degraded AND !CrossReset)->CrossReady)",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P12",
      "requirement_ids": [
        "R12"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G(CrossReset -> (!CrossReady AND b_outputs_safe))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P13",
      "requirement_ids": [
        "R13"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G((CrossReady AND !CrossReset)->X(CrossReady))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P14",
      "requirement_ids": [
        "R14"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G(CrossBlocked = (SubsystemBEnable AND !CrossReady))",
      "source": "independently authored from the requirement contract"
    }
  ]
}
