{
  "schema_version": "1.0",
  "semantics": "end-of-scan state sequence; initial state precedes scan 1",
  "notation": "IEC-ST-VerifyBench temporal DSL; see SCHEMA.md",
  "properties": [
    {
      "id": "P1",
      "requirement_ids": [
        "R1"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G(A_Disagreeing = (A_Enable AND ABS(A_SensorA-A_SensorB)>A_MaxDifference))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P2",
      "requirement_ids": [
        "R2"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G(within(3, A_Disagreeing, A_Alarm))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P3",
      "requirement_ids": [
        "R3"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G((A_Disagreeing AND duration(A_Disagreeing)<3) -> !A_Alarm)",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P4",
      "requirement_ids": [
        "R4"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G((A_Reset AND !A_Disagreeing) -> !A_Alarm)",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P5",
      "requirement_ids": [
        "R5"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G((B_Value>=B_HighLimit) -> B_HighAlarm)",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P6",
      "requirement_ids": [
        "R6"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G((B_Value>=B_HighHighLimit) -> (B_HighAlarm AND B_HighHighAlarm AND B_Shutdown))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P7",
      "requirement_ids": [
        "R7"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G((B_Value>=B_HighLimit AND B_Value<B_HighHighLimit AND !B_HighHighAlarm) -> !B_Shutdown)",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P8",
      "requirement_ids": [
        "R8"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G((B_Reset AND B_Value<B_HighLimit) -> (!B_HighAlarm AND !B_HighHighAlarm AND !B_Shutdown))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P9",
      "requirement_ids": [
        "R9"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G(CrossReset -> !CrossReady) AND G((A_Alarm AND !CrossReset)->CrossReady)",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P10",
      "requirement_ids": [
        "R10"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G(CrossReset -> (!CrossReady AND b_outputs_safe))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P11",
      "requirement_ids": [
        "R11"
      ],
      "kind": "functional",
      "mandatory": true,
      "expression": "G((CrossReady AND !CrossReset)->X(CrossReady))",
      "source": "independently authored from the requirement contract"
    },
    {
      "id": "P12",
      "requirement_ids": [
        "R12"
      ],
      "kind": "safety",
      "mandatory": true,
      "expression": "G(CrossBlocked = (SubsystemBEnable AND !CrossReady))",
      "source": "independently authored from the requirement contract"
    }
  ]
}
