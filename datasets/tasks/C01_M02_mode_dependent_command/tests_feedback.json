          "repeat": 1,
          "check": "each"
        },
        {
          "inputs": {
            "AutoMode": false,
            "AutoDemand": true,
            "ManualDemand": false,
            "SafetyOK": true,
            "Inhibit": false
          },
          "expect": {
            "Command": false,
            "Blocked": false
          },
          "repeat": 1,
          "check": "each"
        }
      ]
    }
  ]
