{
  "provider": {
    "name": "teamorouter",
    "base_url": "https://api.teamorouter.com/v1",
    "api_key_env": "TEAMOROUTER_API_KEY",
    "requested_model": "claude-sonnet-5",
    "allowed_resolved_models": ["claude-sonnet-5"],
    "timeout_seconds": 600,
    "max_output_tokens": 8192,
    "history_mode": "stateless",
    "transport_retries": 6
  },
  "experiment": {
    "method_revision": "agentic-context-v5.2-dvp48es300r-v1",
    "max_candidates": 10,
    "max_feedback_chars": 8000,
    "certificate_version": "v3",
    "context_strategy": "state_packet",
    "anchor_policy": "non_regression",
    "repair_policy": "adaptive",
    "pre_emit_review": true,
    "contract_risk_analysis": true,
    "duplicate_candidate_guard": true,
    "sealed_rejection_policy": "blind_restart",
    "max_sealed_attempts": 3,
    "inconclusive_recovery_policy": "blind_restart",
    "max_inconclusive_restarts": 1,
    "blind_restart_profiles": [
      "contrastive_guard_table",
      "pre_state_event_snapshot",
      "transition_then_decode",
      "minimal_priority_chain",
      "verification_bounded_state"
    ],
    "domain_context": {
      "enabled": true,
      "max_cards": 5,
      "max_chars": 7000
    },
    "required_visible_gates": [
      "compiler",
      "plcverif",
      "openplc_feedback",
      "dvp48es300r_feedback"
    ],
    "sealed_gate": "openplc_dvp48es300r_sealed",
    "stop_on_visible_pass": true,
    "development_only": false,
    "verification_profile": "MatIEC -> PLCverif(all properties) -> OpenPLC(feedback) -> ISPSoft+DVP-ES3(feedback) -> OpenPLC(sealed)+ISPSoft+DVP-ES3(sealed)"
  },
  "validators": [
    {
      "name": "compiler",
      "kind": "command",
      "blocking": true,
      "protocol": "json",
      "version": "matiec-0.1",
      "command": [
        "python3", "{config_dir}/../scripts/matiec_validator.py",
        "--candidate", "{candidate}",
        "--iec2iec", "{config_dir}/../../../../Source_codes_Agents4PLC/tools/matiec/iec2iec"
      ]
    },
    {
      "name": "plcverif",
      "kind": "command",
      "blocking": true,
      "inconclusive_is_blocking": true,
      "inconclusive_retries": 0,
      "protocol": "json",
      "timeout_seconds": 900,
      "version": "PLCverif-1.0.0.202410210930+nuXmv-2.0.0+all-properties-v2+actionable-counterexample-v1",
      "command": [
        "python3", "{config_dir}/../scripts/formal_plcverif.py",
        "--candidate", "{candidate}",
        "--task-dir", "{task_dir}",
        "--plcverif", "{config_dir}/../../../../Source_codes_Agents4PLC/tools/plcverif/plcverif-cli",
        "--nuxmv", "{config_dir}/../../../../Source_codes_Agents4PLC/tools/nuXmv-2.0.0-Linux/bin/nuXmv",
        "--cbmc", "{config_dir}/../../../../Source_codes_Agents4PLC/tools/cbmc-6.10.0/usr/bin/cbmc",
        "--timer-library", "{config_dir}/../formal_lib/iec_timers_100ms.scl",
        "--numeric-library", "{config_dir}/../formal_lib/iec_numeric_functions.scl",
        "--property-kind", "all",
        "--minimum-properties", "1",
        "--backend-timeout", "120",
        "--cbmc-unwind", "10",
        "--counterexample-feedback", "actionable",
        "--case-workers", "1"
      ]
    },
    {
      "name": "openplc_feedback",
      "kind": "command",
      "blocking": true,
      "inconclusive_is_blocking": true,
      "inconclusive_retries": 1,
      "inconclusive_retry_delay_seconds": 1,
      "protocol": "json",
      "timeout_seconds": 420,
      "version": "OpenPLC_v3@b5d41356+visible-feedback-split-v1+one-scan-request-ack-v2",
      "command": [
        "python3", "{config_dir}/../scripts/openplc_sealed_validator.py",
        "--candidate", "{candidate}",
        "--task-dir", "{task_dir}",
        "--docker", "/snap/bin/docker",
        "--image", "plc-egbs/openplc-v3:b5d41356",
        "--runner", "{config_dir}/../scripts/openplc_container_runner.py",
        "--case-role", "feedback",
        "--include-failure-prefix"
      ]
    },
    {
      "name": "dvp48es300r_feedback",
      "kind": "command",
      "blocking": true,
      "inconclusive_is_blocking": true,
      "inconclusive_retries": 1,
      "inconclusive_retry_delay_seconds": 2,
      "protocol": "json",
      "timeout_seconds": 1800,
      "version": "ISPSoft-3.24+COMMGR-2.11+DVP-ES3+visible-feedback-v1",
      "command": [
        "python3", "{config_dir}/../scripts/dvp48es300r_validator.py",
        "--candidate", "{candidate}",
        "--task-dir", "{task_dir}",
        "--case-role", "feedback",
        "--timeout-seconds", "1740"
      ]
    },
    {
      "name": "openplc_dvp48es300r_sealed",
      "kind": "command",
      "blocking": true,
      "sealed": true,
      "inconclusive_retries": 1,
      "inconclusive_retry_delay_seconds": 2,
      "protocol": "json",
      "timeout_seconds": 2400,
      "version": "OpenPLC-sealed+ISPSoft-3.24+COMMGR-2.11+DVP-ES3-sealed-v1",
      "command": [
        "python3", "{config_dir}/../scripts/dvp48es300r_sealed_composite.py",
        "--candidate", "{candidate}",
        "--task-dir", "{task_dir}",
        "--openplc-validator", "{config_dir}/../scripts/openplc_sealed_validator.py",
        "--openplc-runner", "{config_dir}/../scripts/openplc_container_runner.py",
        "--docker", "/snap/bin/docker",
        "--image", "plc-egbs/openplc-v3:b5d41356",
        "--dvp-validator", "{config_dir}/../scripts/dvp48es300r_validator.py",
        "--dvp-timeout-seconds", "2280"
      ]
    }
  ]
}
