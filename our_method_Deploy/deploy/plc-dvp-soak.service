[Unit]
Description=100-job ISPSoft/COMMGR long-stability qualification
After=plc-dvp-bridge.service
Requires=plc-dvp-bridge.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/plc-generation/app
EnvironmentFile=/opt/plc-generation/config/service.env
EnvironmentFile=/opt/plc-generation/config/dvp-validator.env
ExecStart=/opt/plc-generation/app/scripts/run_vendor_soak.py --spool-root /opt/plc-generation/dvp-bridge/dvp-spool --cycles 25 --report /opt/plc-generation/data/qualification/vps_windows_soak.jsonl
Nice=10
IOSchedulingClass=idle
