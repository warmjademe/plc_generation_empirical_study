[Unit]
Description=Verified backup of PLC job database and evidence
After=plc-generation-postgres.service
Requires=plc-generation-postgres.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/plc-generation/app
ExecStart=/opt/plc-generation/app/scripts/backup_production.py --data-root /opt/plc-generation/data --backup-root /opt/plc-generation/backups --retention-days 14
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/plc-generation/backups
