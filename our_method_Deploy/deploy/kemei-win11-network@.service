[Unit]
Description=Private host-only network for Kemei Windows validation VM %i
Before=kemei-win11@%i.service
After=network.target

[Service]
Type=simple
EnvironmentFile=/opt/plc-generation/config/win11-%i.env
ExecStart=/usr/local/libexec/kemei-win11-network-up.sh
ExecStop=/usr/local/libexec/kemei-win11-network-down.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
