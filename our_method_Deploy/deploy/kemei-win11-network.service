[Unit]
Description=Private host-only network for the Kemei Windows validation VM
Before=kemei-win11.service
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/libexec/kemei-win11-network-up.sh
ExecStop=/usr/local/libexec/kemei-win11-network-down.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
