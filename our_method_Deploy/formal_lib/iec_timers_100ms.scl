(******************************************************************************
  IEC timer environment model for PLCverif qualification.

  Scope: one invocation of each instance per 100 ms PLC scan.  This source is
  passed to the unmodified PLCverif STEP 7 frontend together with the candidate.
  It is an explicit environment model, not a replacement verification engine.
******************************************************************************)

FUNCTION_BLOCK TON
VAR_INPUT
    IN : BOOL;
    PT : TIME;
END_VAR
VAR_OUTPUT
    Q : BOOL := FALSE;
    ET : TIME := T#0ms;
END_VAR

IF NOT IN THEN
    Q := FALSE;
    ET := T#0ms;
ELSIF PT <= T#0ms THEN
    Q := TRUE;
    ET := T#0ms;
ELSIF ET < PT THEN
    ET := ET + T#100ms;
    IF ET >= PT THEN
        ET := PT;
        Q := TRUE;
    ELSE
        Q := FALSE;
    END_IF;
ELSE
    Q := TRUE;
END_IF;

END_FUNCTION_BLOCK

FUNCTION_BLOCK TOF
VAR_INPUT
    IN : BOOL;
    PT : TIME;
END_VAR
VAR_OUTPUT
    Q : BOOL := FALSE;
    ET : TIME := T#0ms;
END_VAR
VAR
    WasActive : BOOL := FALSE;
END_VAR

IF IN THEN
    WasActive := TRUE;
    Q := TRUE;
    ET := T#0ms;
ELSIF WasActive AND (PT > T#0ms) THEN
    IF ET < PT THEN
        ET := ET + T#100ms;
    END_IF;
    IF ET >= PT THEN
        ET := PT;
        Q := FALSE;
        WasActive := FALSE;
    ELSE
        Q := TRUE;
    END_IF;
ELSE
    Q := FALSE;
    ET := T#0ms;
    WasActive := FALSE;
END_IF;

END_FUNCTION_BLOCK
