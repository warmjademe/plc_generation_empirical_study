# Never commit real credentials. Install the production file outside the repository.
PLC_PROJECT_ROOT=/opt/plc-generation/app
PLC_DATA_ROOT=/opt/plc-generation/data
HOME=/opt/plc-generation/data/runtime-home
PLC_TOOL_ROOT=/opt/plc-generation/tools
PLC_OPENPLC_IMAGE=plc-egbs/openplc-v3:b5d41356
# Production persistence. Leave unset only for single-process local development.
PLC_DATABASE_URL=postgresql://plc_generation:change-me@127.0.0.1:5433/plc_generation
PLC_HOST=127.0.0.1
PLC_PORT=18081
PLC_WORKERS=1
PLC_JOB_WORKERS=4
PLC_JOB_LEASE_SECONDS=300
PLC_JOB_POLL_SECONDS=2
# Web service sets this false; plc-generation-worker.service overrides it to true.
PLC_RUN_BACKGROUND_JOBS=false
PLC_MAX_ACTIVE_JOBS=8
# Terminal jobs older than this are moved to the archive view; 0 disables automatic archival.
PLC_JOB_RETENTION_DAYS=180
PLC_WEB_API_TOKEN=replace-with-a-long-random-value
PLC_LOGIN_USERNAME=kemei
PLC_LOGIN_PASSWORD=replace-before-production
PLC_SESSION_SECRET=replace-with-a-separate-long-random-value
PLC_SESSION_TTL_SECONDS=43200
TEAMOROUTER_API_KEY=
SONNET_PROXY_API_KEY=
DEEPSEEK_API_KEY=
