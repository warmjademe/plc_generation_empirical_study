{
  "provider": {
    "name": "kimi-coding",
    "base_url": "https://api.kimi.com/coding/v1",
    "api_key_env": "KIMI_API_KEY",
    "requested_model": "k3",
    "allowed_resolved_models": ["k3"],
    "timeout_seconds": 180,
    "max_output_tokens": 8192,
    "history_mode": "full"
  },
  "experiment": {
    "max_candidates": 10,
    "max_feedback_chars": 6000,
    "required_visible_gates": ["interface", "compiler", "feedback_tests", "formal"],
    "sealed_gate": "sealed_openplc",
    "stop_on_visible_pass": true,
    "development_only": true
  },
  "validators": [
    {
      "name": "interface",
      "kind": "interface",
      "blocking": true
    },
    {
      "name": "compiler",
      "kind": "command",
      "blocking": true,
      "protocol": "json",
      "version": "matiec-0.1",
      "command": [
        "python3",
        "{config_dir}/../scripts/matiec_validator.py",
        "--candidate", "{candidate}",
        "--iec2iec", "{config_dir}/../../../../Source_codes_Agents4PLC/tools/matiec/iec2iec"
      ]
    },
    {
      "name": "feedback_tests",
      "kind": "dataset_scan",
      "suite": "feedback",
      "blocking": true,
      "engine_root": "../../../../ISPSoft_CLI_Linux/src"
    },
    {
      "name": "formal",
      "kind": "command",
      "blocking": true,
      "protocol": "json",
      "timeout_seconds": 180,
      "version": "PLCverif-1.0.0.202410210930+nuXmv-2.0.0",
      "command": [
        "python3",
        "{config_dir}/../scripts/formal_plcverif.py",
        "--candidate", "{candidate}",
        "--task-dir", "{task_dir}",
        "--plcverif", "{config_dir}/../../../../Source_codes_Agents4PLC/tools/plcverif/plcverif-cli",
        "--nuxmv", "{config_dir}/../../../../Source_codes_Agents4PLC/tools/nuXmv-2.0.0-Linux/bin/nuXmv",
        "--cbmc", "{config_dir}/../../../../Source_codes_Agents4PLC/tools/cbmc-6.10.0/usr/bin/cbmc",
        "--timer-library", "{config_dir}/../formal_lib/iec_timers_100ms.scl",
        "--numeric-library", "{config_dir}/../formal_lib/iec_numeric_functions.scl"
      ]
    },
    {
      "name": "sealed_openplc",
      "kind": "command",
      "blocking": true,
      "sealed": true,
      "protocol": "json",
      "timeout_seconds": 420,
      "version": "OpenPLC_v3@b5d41356dab4aeadca0dd7ca64ba542f870b595d",
      "command": [
        "python3",
        "{config_dir}/../scripts/openplc_sealed_validator.py",
        "--candidate", "{candidate}",
        "--task-dir", "{task_dir}",
        "--docker", "/snap/bin/docker",
        "--image", "plc-egbs/openplc-v3:b5d41356",
        "--runner", "{config_dir}/../scripts/openplc_container_runner.py"
      ]
    }
  ]
}
